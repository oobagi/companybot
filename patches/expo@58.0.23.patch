+type ScriptTarget = { injectJavaScript: (script: string) => unknown };
+
+/** Native Expo views return a promise even though WebView's public method is typed void. */
+export function injectJavaScriptSafely(
+  view: ScriptTarget,
+  script: string,
+  isDetached: () => boolean
+) {
+  const report = (error: unknown) => {
+    // Ignore only a late call targeting the native view that has been removed.
+    // A live-view failure or any other exception still needs to be diagnosed.
+    const removedView = error instanceof Error &&
+      /Unable to find the (?:class )?'?[\w.]*DomWebView'? view with tag '?\d+'?/.test(error.message);
+    if (removedView) {
+      if (isDetached()) return;
+      // Native activity teardown can precede React's ref/layout cleanup.
+      // Recheck once after that commit; a still-attached failure remains visible.
+      setTimeout(() => { if (!isDetached()) console.error(error); }, 0);
+      return;
+    }
+    console.error(error);
+  };
+  try {
+    void Promise.resolve(view.injectJavaScript(script)).catch(report);
+  } catch (error) {
+    report(error);
+  }
+}
