{
  "name": "companybot",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "convex dev",
    "dev:desktop": "pnpm --filter @companybot/desktop dev",
    "dev:web": "pnpm --filter @companybot/desktop dev:web",
    "build:web": "pnpm --filter @companybot/desktop build:web",
    "test": "pnpm -r test",
    "test:scale": "pnpm --filter @companybot/backend test:scale",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "release": "node scripts/release.mjs",
    "package:desktop": "pnpm --filter @companybot/desktop package",
    "dev:mobile": "pnpm --filter @companybot/mobile start"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "convex": "1.49.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
