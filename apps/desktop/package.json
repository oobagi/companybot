{
  "name": "@companybot/desktop",
  "productName": "Companybot",
  "version": "0.1.0-alpha.10",
  "description": "AI-first team chat. Agents are teammates.",
  "author": "Jaden Watson",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p .",
    "lint": "oxlint --report-unused-disable-directives src"
  },
  "//": "Everything is bundled by electron-vite, so the packaged app ships no node_modules. Keep all packages in devDependencies.",
  "devDependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@companybot/backend": "workspace:*",
    "@companybot/core": "workspace:*",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/prosemirror-sync": "^0.2.7",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-mention": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "convex": "1.49.0",
    "convex-helpers": "^0.1.133",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "emojibase-data": "^18.0.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "19.3.1",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "@shadcn/lint": "^0.2.5",
    "docx-preview": "^0.4.1"
  },
  "dependencies": {
    "@streamdown/code": "^2.0.0"
  }
}
