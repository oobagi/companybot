# Written by `npx convex dev` — points the app at your Convex deployment.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Server-side secrets live in Convex, not here. Set them with `npx convex env set`:
#   AI_GATEWAY_API_KEY   Vercel AI Gateway key (agents)
#   AUTH_RESEND_KEY      Resend key (sign-in emails)
#   AUTH_EMAIL_FROM      e.g. "Companybot <signin@yourdomain.com>"
#   JWT_PRIVATE_KEY, JWKS, SITE_URL   Convex Auth (see wiki/architecture.md)
#   CONNECTIONS_KEY      32 random bytes, base64 (encrypts plugin credentials)
