{
  "expo": {
    "name": "Companybot",
    "slug": "companybot",
    "version": "0.1.0",
    "scheme": "companybot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.companybot.mobile"
    },
    "android": {
      "package": "com.companybot.mobile"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
