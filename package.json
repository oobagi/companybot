{
  "name": "companybot",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "convex dev",
    "dev:desktop": "pnpm --filter @companybot/desktop dev",
    "test": "pnpm -r test",
    "test:scale": "pnpm --filter @companybot/backend test:scale",
    "typecheck": "pnpm -r typecheck",
    "release": "node scripts/release.mjs",
    "package:desktop": "pnpm --filter @companybot/desktop package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "convex": "1.47.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
